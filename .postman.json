      {
        "name": "Reports",
        "item": [
          {
            "name": "GET /reports",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "pm.test('Status 200', () => pm.response.to.have.status(200));",
                    "pm.test('Returns array', () => {",
                    "  const body = pm.response.json();",
                    "  pm.expect(body).to.be.an('array');",
                    "});",
                    "pm.test('Reports ordered newest first', () => {",
                    "  const body = pm.response.json();",
                    "  if (body.length > 1) {",
                    "    const t1 = new Date(body[0].timestamp).getTime();",
                    "    const t2 = new Date(body[1].timestamp).getTime();",
                    "    pm.expect(t1).to.be.at.least(t2);",
                    "  }",
                    "});"
                  ],
                  "type": "text/javascript"
                }
              }
            ],
            "request": {
              "method": "GET",
              "url": "{{base_url}}/reports"
            }
          }
        ]
      },
      {
        "name": "Models Status",
        "item": [
          {
            "name": "GET /models/status",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "pm.test('Status 200', () => pm.response.to.have.status(200));",
                    "pm.test('Contains all 6 disease IDs', () => {",
                    "  const body = pm.response.json();",
                    "  const expected = ['brain-tumor','pneumonia','skin-cancer','eye-disease','heart-disease','diabetes'];",
                    "  expected.forEach(id => {",
                    "    pm.expect(body).to.have.property(id);",
                    "    pm.expect(['real','mock']).to.include(body[id]);",
                    "  });",
                    "});"
                  ],
                  "type": "text/javascript"
                }
              }
            ],
            "request": {
              "method": "GET",
              "url": "{{base_url}}/models/status"

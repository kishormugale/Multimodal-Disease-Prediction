{
  "workspace_id": null,
  "collection_id": null,
  "environment_id": null,
  "collection": {
    "info": {
      "name": "KDM Care Hospital – AI Disease Prediction API",
      "description": "Complete API collection for the KDM Care Hospital AI Multimodal Disease Prediction System. Covers authentication, patients, predictions (tabular + image), reports, and model status endpoints.",
      "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
      {
        "key": "base_url",
        "value": "http://localhost:8000/api",
        "type": "string"
      },
      {
        "key": "access_token",
        "value": "",
        "type": "string"
      }
    ],
    "item": [
      {
        "name": "Auth",
        "item": [
          {
            "name": "Login – valid credentials",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "pm.test('Status 200', () => pm.response.to.have.status(200));",
                    "pm.test('Has access_token', () => {",
                    "  const body = pm.response.json();",
                    "  pm.expect(body).to.have.property('access_token');",
                    "  pm.expect(body.token_type).to.eql('bearer');",
                    "  pm.collectionVariables.set('access_token', body.access_token);",
                    "});"
                  ],
                  "type": "text/javascript"
                }
              }
            ],
            "request": {
              "method": "POST",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": {
                "mode": "raw",
                "raw": "{\"email\": \"doctor@kdmcare.com\", \"password\": \"password123\"}"
              },
              "url": "{{base_url}}/auth/login"
            }
          },
          {
            "name": "Login – short password (expect 401)",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "pm.test('Status 401', () => pm.response.to.have.status(401));",

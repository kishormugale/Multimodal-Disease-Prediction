      {
        "name": "Patients",
        "item": [
          {
            "name": "GET /patients",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "pm.test('Status 200', () => pm.response.to.have.status(200));",
                    "pm.test('Returns array', () => {",
                    "  const body = pm.response.json();",
                    "  pm.expect(body).to.be.an('array');",
                    "});",
                    "pm.test('Each patient has required fields', () => {",
                    "  const body = pm.response.json();",
                    "  if (body.length > 0) {",
                    "    const p = body[0];",
                    "    pm.expect(p).to.have.all.keys('id','name','age','gender','status','lastVisit');",
                    "  }",
                    "});"
                  ],
                  "type": "text/javascript"
                }
              }
            ],
            "request": {
              "method": "GET",
              "url": "{{base_url}}/patients"
            }
          },
          {
            "name": "POST /patients – create patient",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "pm.test('Status 201', () => pm.response.to.have.status(201));",
                    "pm.test('Patient has PT- id prefix', () => {",
                    "  const body = pm.response.json();",
                    "  pm.expect(body.id).to.match(/^PT-/);",
                    "  pm.collectionVariables.set('patient_id', body.id);",
                    "});"
                  ],
                  "type": "text/javascript"
                }
              }
            ],
            "request": {
              "method": "POST",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": {
                "mode": "raw",
                "raw": "{\"name\": \"John Doe\", \"age\": 45, \"gender\": \"Male\", \"status\": \"Stable\"}"
              },
              "url": "{{base_url}}/patients"
            }
          },
          {
            "name": "POST /patients – missing field (expect 422)",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "pm.test('Status 422', () => pm.response.to.have.status(422));"
                  ],
                  "type": "text/javascript"
                }
              }
            ],
            "request": {
              "method": "POST",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": {
                "mode": "raw",
                "raw": "{\"name\": \"Jane Doe\", \"age\": 30}"
              },
              "url": "{{base_url}}/patients"
            }
          }
        ]
      },
      {
        "name": "Predict – Tabular",
        "item": [
          {
            "name": "POST /predict/heart-disease",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "pm.test('Status 200', () => pm.response.to.have.status(200));",
                    "pm.test('PredictionResponse schema', () => {",
                    "  const body = pm.response.json();",
                    "  pm.expect(['Positive','Negative']).to.include(body.result);",
                    "  pm.expect(body.confidence).to.be.within(0, 100);",
                    "  pm.expect(['High','Medium','Low']).to.include(body.risk);",
                    "  pm.expect(body.suggestion).to.be.a('string').and.not.empty;",
                    "});"
                  ],
                  "type": "text/javascript"
                }
              }
            ],
            "request": {
              "method": "POST",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": {
                "mode": "raw",
                "raw": "{\"age\": 55, \"sex\": 1, \"chest_pain\": 3, \"bp\": 140, \"cholesterol\": 250, \"blood_sugar\": 0, \"restecg\": 1, \"heart_rate\": 150, \"exang\": 0, \"oldpeak\": 2.3, \"slope\": 2, \"ca\": 0, \"thal\": 2}"
              },
              "url": "{{base_url}}/predict/heart-disease"
            }
